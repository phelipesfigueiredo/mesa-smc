# Copie para .env e preencha. Nunca compartilhe este arquivo.
# Chaves da conta DEMO (Bitget > Demo trading > API). Use estas primeiro.
BITGET_DEMO_KEY=
BITGET_DEMO_SECRET=
BITGET_DEMO_PASSPHRASE=

# Chaves da conta REAL. Crie a API só com permissão de "Futures trade", SEM saque, e com IP liberado.
BITGET_KEY=
BITGET_SECRET=
BITGET_PASSPHRASE=
# Trava de segurança: a conta real só funciona com true
ALLOW_LIVE=false

# Se a conta demo recusar símbolos como SBTCSUSDT, troque para true
DEMO_PLAIN_SYMBOLS=false
PORT=8787

# Tweets: chave da API oficial do X (opcional, paga). Sem ela o app tenta espelhos públicos gratuitos, que são instáveis.
X_BEARER_TOKEN=
